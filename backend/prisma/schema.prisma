generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BoardVisibility {
  PRIVATE
  WORKSPACE
}

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ActivityType {
  BOARD_CREATED
  BOARD_UPDATED
  COLUMN_CREATED
  COLUMN_UPDATED
  COLUMN_DELETED
  CARD_CREATED
  CARD_UPDATED
  CARD_MOVED
  CARD_DELETED
  MEMBER_ADDED
  LABEL_CREATED
  SPRINT_CREATED
  SPRINT_UPDATED
  TIMELOG_ADDED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ownedBoards   Board[]        @relation("BoardOwner")
  memberships   BoardMember[]
  assignedCards Card[]         @relation("CardAssignee")
  activities    Activity[]
  refreshTokens RefreshToken[]
  timeLogs      TimeLog[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Board {
  id          String          @id @default(uuid())
  title       String
  description String?
  visibility  BoardVisibility @default(PRIVATE)
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     BoardMember[]
  columns     Column[]
  cards       Card[]
  labels      Label[]
  sprints     Sprint[]
  activities  Activity[]
}

model BoardMember {
  boardId   String
  userId    String
  role      BoardRole @default(MEMBER)
  createdAt DateTime  @default(now())
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
}

model Sprint {
  id        String       @id @default(uuid())
  boardId   String
  name      String
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([boardId, status])
}

model Column {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([boardId, position])
}

model Card {
  id             String       @id @default(uuid())
  boardId        String
  columnId       String
  sprintId       String?
  title          String
  description    String?
  priority       CardPriority @default(MEDIUM)
  dueDate        DateTime?
  assigneeId     String?
  position       Int
  estimatedHours Float        @default(0)
  executedHours  Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  board          Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column         Column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  sprint         Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  labels         CardLabel[]
  activities     Activity[]
  timeLogs       TimeLog[]

  @@index([columnId, position])
  @@index([boardId])
  @@index([sprintId])
  @@index([assigneeId])
}

model TimeLog {
  id              String    @id @default(uuid())
  cardId          String
  userId          String
  description     String?
  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationSeconds Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  card            Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId])
}

model Label {
  id        String      @id @default(uuid())
  boardId   String
  name      String
  color     String
  createdAt DateTime    @default(now())
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     CardLabel[]

  @@unique([boardId, name])
  @@index([boardId])
}

model CardLabel {
  cardId  String
  labelId String
  card    Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
}

model Activity {
  id        String       @id @default(uuid())
  boardId   String
  cardId    String?
  actorId   String
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card      Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  actor     User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
}
